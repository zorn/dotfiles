#!/usr/bin/env bash
#
# Per-worktree Postgres databases for a Phoenix app. A repo opts in from its
# own .config/wt.toml. A marker file cannot tell a vanilla Postgres app from
# one with its own database flow, so this is not automatic:
#
#   [pre-start]
#   postgres = "~/.config/worktrunk/hooks/postgres names"
#
#   [post-start]
#   postgres = "~/.config/worktrunk/hooks/postgres create"
#
# `names` must run in pre-start. Until the names are in .env.worktree, a mix
# run in the worktree falls back to the primary database and migrates it.
#
# `drop` needs no opt-in. The global pre-remove hook calls it for every
# worktree, and it does nothing unless `names` ran.

set -euo pipefail

usage() {
  printf 'usage: %s names|create|drop\n' "${0##*/}" >&2
  exit 64
}

[ "$#" -eq 1 ] || usage

# The _dev_ and _test_ infixes mean a worktree database name never matches
# the primary checkout's, so dropping one can never drop the primary.
dev_name() { wt step eval "{{ (repo ~ '_dev_' ~ branch) | sanitize_db }}"; }
test_name() { wt step eval "{{ (repo ~ '_test_' ~ branch) | sanitize_db }}"; }

case "$1" in
  names)
    # The global pre-start hook creates .env.worktree, and this appends to it.
    # Fail loudly if that hook has not run, rather than write half a file.
    if [ ! -f .env.worktree ]; then
      printf 'postgres: no .env.worktree; the global pre-start hook must run first\n' >&2
      exit 1
    fi

    dev_database="$(dev_name)"
    test_database="$(test_name)"
    printf 'DEV_DATABASE_NAME=%s\nTEST_DATABASE_NAME=%s\n' "$dev_database" "$test_database" >>.env.worktree
    wt config state vars set "dev-database=$dev_database"
    wt config state vars set "test-database=$test_database"
    printf 'postgres: databases %s and %s\n' "$dev_database" "$test_database"
    ;;
  create)
    # Each command reads the names from .env.worktree through config/runtime.exs.
    mix ecto.setup
    MIX_ENV="test" mix ecto.create
    MIX_ENV="test" mix ecto.migrate
    ;;
  drop)
    dev_database="$(wt config state vars get dev-database)"
    test_database="$(wt config state vars get test-database)"
    if [ -z "$dev_database$test_database" ]; then
      exit 0
    fi

    # Drop only the exact names `names` computes for this repo and branch. A
    # stored database name edited by hand then can never reach the primary.
    expected_dev="$(dev_name)"
    expected_test="$(test_name)"
    if [ "$dev_database" != "$expected_dev" ] || [ "$test_database" != "$expected_test" ]; then
      printf 'postgres: refusing to drop "%s" and "%s"; expected %s and %s\n' \
        "$dev_database" "$test_database" "$expected_dev" "$expected_test" >&2
      exit 1
    fi

    # The app's runtime.exs prefers a shell variable over .env.worktree. So the
    # drop uses the app's own connection settings.
    if ! DEV_DATABASE_NAME="$dev_database" mix ecto.drop ||
      ! MIX_ENV="test" TEST_DATABASE_NAME="$test_database" mix ecto.drop; then
      printf 'postgres: drop failed. If a server or IEx session in this worktree is still running, stop it and run wt remove again.\n' >&2
      exit 1
    fi

    wt config state vars clear dev-database
    wt config state vars clear test-database
    printf 'postgres: dropped %s and %s\n' "$dev_database" "$test_database"
    ;;
  *)
    usage
    ;;
esac
