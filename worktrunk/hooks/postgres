#!/usr/bin/env bash
#
# Per-worktree Postgres databases for a Phoenix app. A repo opts in from its
# own .config/wt.toml, because a marker file cannot tell a vanilla Postgres
# app from one with its own database flow:
#
#   [pre-start]
#   postgres = "~/.config/worktrunk/hooks/postgres names"
#
#   [post-start]
#   postgres = "~/.config/worktrunk/hooks/postgres create"
#
# `names` must run in pre-start. Until the names are in .env.worktree, a mix
# run in the worktree falls back to the primary database and migrates it.

set -euo pipefail

usage() {
  printf 'usage: %s names|create\n' "${0##*/}" >&2
  exit 64
}

[ "$#" -eq 1 ] || usage

case "$1" in
  names)
    # The _dev_ and _test_ infixes keep these names from ever matching the
    # primary checkout's databases, which teardown relies on.
    dev_database="$(wt step eval "{{ (repo ~ '_dev_' ~ branch) | sanitize_db }}")"
    test_database="$(wt step eval "{{ (repo ~ '_test_' ~ branch) | sanitize_db }}")"
    printf 'DEV_DATABASE_NAME=%s\nTEST_DATABASE_NAME=%s\n' "$dev_database" "$test_database" >>.env.worktree
    wt config state vars set "dev-database=$dev_database"
    wt config state vars set "test-database=$test_database"
    printf 'postgres: databases %s and %s\n' "$dev_database" "$test_database"
    ;;
  create)
    # Both steps read the names from .env.worktree through config/runtime.exs.
    mix ecto.setup
    MIX_ENV="test" mix ecto.create
    MIX_ENV="test" mix ecto.migrate
    ;;
  *)
    usage
    ;;
esac
